# Salesforce External Client App (Client Credentials)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Org My Domain — NOT the *salesforce-setup.com* Setup UI URL
SF_INSTANCE_URL=https://your-org.my.salesforce.com
